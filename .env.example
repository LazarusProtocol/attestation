# Lazarus Attestation Enclave & 2-of-3 FROST MPC Configuration
LAZARUS_ENCLAVE_HOST=0.0.0.0
LAZARUS_ENCLAVE_PORT=8085
LAZARUS_SIGNING_MODE=frost_2_of_3
LAZARUS_MAX_HOURLY_OUTFLOW=5000000000

# In production, replace with high-entropy 32-byte hex seed or AWS Nitro Enclave KMS sealed seed
LAZARUS_ORACLE_SIGNING_SEED_HEX=2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a

# Optional Bearer Token for mutual authentication with indexer
LAZARUS_ATTESTATION_API_KEY=

